{
  "name": "empreinte-monorepo",
  "private": true,
  "description": "Empreinte (French for \"footprint\") — find where a username exists across hundreds of websites.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build-sites": "tsx scripts/build-sites.ts",
    "validate-sites": "tsx scripts/build-sites.ts --check",
    "check-site": "tsx scripts/check-site.ts",
    "gen-schema": "tsx scripts/gen-schema.ts",
    "import-sherlock": "tsx scripts/import-sherlock.ts",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
