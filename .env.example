# All variables are optional.

# Searches allowed per IP and per minute (default: 5)
RATE_LIMIT_PER_MINUTE=5
# Searches running at the same time on one server instance (default: 10)
MAX_CONCURRENT_SEARCHES=10
# Timeout of each request to a site, in milliseconds (default: 12000)
SITE_TIMEOUT_MS=12000
# Simultaneous requests within one search (default: 20)
SEARCH_CONCURRENCY=20

# Share the rate limit between instances (recommended on Vercel): https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
